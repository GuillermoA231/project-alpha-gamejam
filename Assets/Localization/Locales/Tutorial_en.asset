  m_TableData:
  - m_Id: 153790840832
    m_Localized: TUTORIAL
    m_Metadata:
      m_Items: []
  - m_Id: 165706858496
    m_Localized: 'How to Play:

      Move with W A S D. Survive as long as possible.

      You
      attack automatically. Level up to improve your stats.'
    m_Metadata:
      m_Items: []
  - m_Id: 194492366848
    m_Localized: STAT EXPLANATION
    m_Metadata:
      m_Items: []
  - m_Id: 216541822976
    m_Localized: 'Damage: Base damage you deal.

      Attack Speed: How fast you
      attack.

      Crit Chance: Chance to land a critical hit.

      Crit Damage:
      Extra damage when you land a critical hit.

      Movement Speed: How fast
      you move.'
    m_Metadata:
      m_Items: []
  - m_Id: 235164532736
    m_Localized: 'Max Health: Total amount of health you have.

      Range: Distance
      of your attacks (Ranged attacks only).

      Regeneration: Rate at which
      you recover health over time.

      Armor: Reduces the damage you take.

      Luck:
      Increases chances of finding upgrades or drops.

      Dodge: Chance to completely
      avoid damage.

      Life Steal: Recover health when dealing damage.'
    m_Metadata:
      m_Items: []
  - m_Id: 278613327872
    m_Localized: BACK TO MENU
    m_Metadata:
      m_Items: []
  references:
    version: 2
